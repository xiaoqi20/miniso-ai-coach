{
  "name": "miniso-shouke-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_API_MODE=mock vite",
    "dev:real": "VITE_API_MODE=real vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:real": "VITE_API_MODE=real vue-tsc --noEmit && VITE_API_MODE=real vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "happy-dom": "^16.8.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.11",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
