# 本地开发配置。生产环境必须使用密钥管理注入，不要提交真实凭据。
APP_ENV=development
DEV_AUTH_ENABLED=true
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=mysql+aiomysql://shouke:shouke_dev@127.0.0.1:3307/shouke?charset=utf8mb4
ALEMBIC_DATABASE_URL=mysql+pymysql://shouke:shouke_dev@127.0.0.1:3307/shouke?charset=utf8mb4
SESSION_COOKIE_NAME=sk_session
SESSION_TTL_HOURS=12
# 生产环境强制 Secure；任何 HTTPS 请求也会自动加 Secure。
COOKIE_SECURE=false